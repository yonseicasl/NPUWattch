# autosweep/site.env — site-local settings, sourced by run_batch.sh.
# Copy to site.env (git-ignored) and edit.  No lab paths belong in
# committed files.

# python3 with gdstk installed — used to generate missing column/array GDS
# and to resolve blank wd fields via the performance-default map.
PYTHON_GDSTK=/path/to/conda/envs/npuwattch/bin/python3
