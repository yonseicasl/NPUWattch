module {{ module_name }} #(
    parameter int EXPONENT_BITS = {{ exp_bits }},
    parameter int MANTISSA_BITS = {{ mantissa_bits }},
    parameter int PIPELINE_STAGES = {{ pipeline_stages }}
) (
    input  logic [EXPONENT_BITS+MANTISSA_BITS:0] i_a,
    input  logic [EXPONENT_BITS+MANTISSA_BITS:0] i_b,
    input  logic                                 i_clk,
    input  logic                                 i_rst_n,
    output logic [EXPONENT_BITS+MANTISSA_BITS:0] o_product,
    output logic                                 o_ovfl,
    output logic                                 o_udfl
);

    function automatic int clogb2(input int bit_depth);
        int value;
        begin
            value = bit_depth - 1;
            for (clogb2 = 0; value > 0; clogb2 = clogb2 + 1) begin
                value = value >> 1;
            end
        end
    endfunction

    localparam int FP_MSB = EXPONENT_BITS + MANTISSA_BITS;
    localparam int SHIFT_COUNTER_BITS = clogb2((2 * MANTISSA_BITS) + 3);
    localparam int EXTRA_STAGES = PIPELINE_STAGES - 2;
    localparam int FRAC_PROD_MSB = (2 * MANTISSA_BITS) + 1;

    logic [FP_MSB:0] a_r;
    logic [FP_MSB:0] b_r;

    logic [FP_MSB:0] product_c;
    logic overflow_c;
    logic underflow_c;

    logic [FP_MSB:0] product_pipe [0:EXTRA_STAGES];
    logic            ovfl_pipe    [0:EXTRA_STAGES];
    logic            udfl_pipe    [0:EXTRA_STAGES];

    integer idx;

    always_ff @(posedge i_clk) begin
        if (!i_rst_n) begin
            a_r <= '0;
            b_r <= '0;
        end else begin
            a_r <= i_a;
            b_r <= i_b;
        end
    end

    wire sign_a = a_r[FP_MSB];
    wire sign_b = b_r[FP_MSB];
    wire [EXPONENT_BITS-1:0] exp_a = a_r[FP_MSB-1:MANTISSA_BITS];
    wire [EXPONENT_BITS-1:0] exp_b = b_r[FP_MSB-1:MANTISSA_BITS];
    wire [MANTISSA_BITS-1:0] frac_a_raw = a_r[MANTISSA_BITS-1:0];
    wire [MANTISSA_BITS-1:0] frac_b_raw = b_r[MANTISSA_BITS-1:0];

    wire exp_a_zero = ~|exp_a;
    wire exp_b_zero = ~|exp_b;
    wire exp_a_all_ones = &exp_a;
    wire exp_b_all_ones = &exp_b;
    wire frac_a_zero = ~|frac_a_raw;
    wire frac_b_zero = ~|frac_b_raw;

    wire zero_a = exp_a_zero && frac_a_zero;
    wire zero_b = exp_b_zero && frac_b_zero;
    wire inf_a = exp_a_all_ones && frac_a_zero;
    wire inf_b = exp_b_all_ones && frac_b_zero;
    wire nan_a = exp_a_all_ones && !frac_a_zero;
    wire nan_b = exp_b_all_ones && !frac_b_zero;

    wire [MANTISSA_BITS:0] frac_a = exp_a_zero ? {1'b0, frac_a_raw} : {1'b1, frac_a_raw};
    wire [MANTISSA_BITS:0] frac_b = exp_b_zero ? {1'b0, frac_b_raw} : {1'b1, frac_b_raw};
    wire sign_product = sign_a ^ sign_b;

    // Subnormal operands (exp field 0) have an effective unbiased exponent of
    // (1 - bias); use an effective exponent field of 1 for them so the biased
    // exponent sum is computed correctly even with a 0 hidden bit.
    wire [EXPONENT_BITS-1:0] exp_a_eff = exp_a_zero ? { {(EXPONENT_BITS-1){1'b0}}, 1'b1} : exp_a;
    wire [EXPONENT_BITS-1:0] exp_b_eff = exp_b_zero ? { {(EXPONENT_BITS-1){1'b0}}, 1'b1} : exp_b;

    /* verilator lint_off WIDTHEXPAND */
    /* verilator lint_off WIDTHTRUNC */
    wire signed [EXPONENT_BITS+2:0] exp_sum = $signed({1'b0, exp_a_eff}) + $signed({1'b0, exp_b_eff}) - $signed((1 << (EXPONENT_BITS - 1)) - 1);
    wire [FRAC_PROD_MSB:0] frac_full_product = frac_a * frac_b;

    logic [SHIFT_COUNTER_BITS-1:0] lead_shift;
    always_comb begin
        lead_shift = FRAC_PROD_MSB + 1;
        for (int j = FRAC_PROD_MSB - 1; j >= 0; j = j - 1) begin
            if (frac_full_product[j]) begin
                lead_shift = (FRAC_PROD_MSB - 1) - j;
                break;
            end
        end
    end

    logic signed [EXPONENT_BITS+2:0] exp_adj;
    logic [FRAC_PROD_MSB:0] frac_norm;
    always_comb begin
        exp_adj = exp_sum;
        frac_norm = frac_full_product;
        if (frac_full_product[FRAC_PROD_MSB]) begin
            frac_norm = frac_full_product >> 1;
            exp_adj = exp_sum + 1;
        end else if (!zero_a && !zero_b && lead_shift != 0) begin
            // Always left-normalize so the leading one sits at FRAC_PROD_MSB-1. The
            // exponent (exp_adj = exp_sum - lead_shift) then selects the result class:
            // >= 1 normal, <= 0 subnormal (handled by the gradual-underflow path which
            // assumes a normalized significand).
            frac_norm = frac_full_product << lead_shift;
            exp_adj = exp_sum - $signed({1'b0, lead_shift});
        end
    end

    wire [MANTISSA_BITS-1:0] frac_product = frac_norm[FRAC_PROD_MSB-1:MANTISSA_BITS];
    wire guard = frac_norm[MANTISSA_BITS-1];
    wire round_bit = (MANTISSA_BITS >= 2) ? frac_norm[MANTISSA_BITS-2] : 1'b0;
    wire sticky = (MANTISSA_BITS >= 3) ? |frac_norm[MANTISSA_BITS-3:0] : 1'b0;
    wire round_up = guard && (round_bit || sticky || frac_product[0]);

    wire [FP_MSB:0] rounded_no_sign = {exp_adj[EXPONENT_BITS-1:0], frac_product} + round_up;

    // Gradual underflow: when the normalized exponent would be <= 0 the product is
    // representable only as a subnormal. The subnormal significand is the normalized
    // significand shifted right by (1 - exp_adj); this identity holds whether or not
    // the significand was left-normalized. The exponent field is forced to zero, and
    // a rounding carry promotes the result to the smallest normal number.
    wire signed [EXPONENT_BITS+3:0] sub_shift_full = $signed(10'sd1) - $signed(exp_adj);
    wire [EXPONENT_BITS+3:0] sub_shift =
        (sub_shift_full > $signed(FRAC_PROD_MSB + 2)) ? (FRAC_PROD_MSB + 2)
        : (sub_shift_full < 0) ? '0
        : sub_shift_full[EXPONENT_BITS+3:0];
    wire [FRAC_PROD_MSB:0] frac_sub = frac_norm >> sub_shift;
    wire [FRAC_PROD_MSB:0] sub_lost_mask = ~({(FRAC_PROD_MSB+1){1'b1}} << sub_shift);
    wire [MANTISSA_BITS-1:0] frac_sub_mant = frac_sub[FRAC_PROD_MSB-1:MANTISSA_BITS];
    wire sub_guard = frac_sub[MANTISSA_BITS-1];
    wire sub_round_bit = (MANTISSA_BITS >= 2) ? frac_sub[MANTISSA_BITS-2] : 1'b0;
    wire sub_sticky = ((MANTISSA_BITS >= 3) ? |frac_sub[MANTISSA_BITS-3:0] : 1'b0)
        | |(frac_norm & sub_lost_mask);
    wire sub_round_up = sub_guard && (sub_round_bit || sub_sticky || frac_sub_mant[0]);
    wire [MANTISSA_BITS:0] sub_rounded = {1'b0, frac_sub_mant} + sub_round_up;
    /* verilator lint_on WIDTHTRUNC */
    /* verilator lint_on WIDTHEXPAND */

    always_comb begin
        product_c = '0;
        if (nan_a || nan_b) begin
            product_c = {1'b0, {EXPONENT_BITS{1'b1}}, 1'b1, {(MANTISSA_BITS-1){1'b0}}};
        end else if ((inf_a && zero_b) || (inf_b && zero_a)) begin
            product_c = {1'b0, {EXPONENT_BITS{1'b1}}, 1'b1, {(MANTISSA_BITS-1){1'b0}}};
        end else if (inf_a || inf_b) begin
            product_c = {sign_product, {EXPONENT_BITS{1'b1}}, {MANTISSA_BITS{1'b0}}};
        end else if (zero_a || zero_b) begin
            product_c = {sign_product, {EXPONENT_BITS + MANTISSA_BITS{1'b0}}};
        end else if (exp_adj <= 0) begin
            product_c = sub_rounded[MANTISSA_BITS]
                ? {sign_product, {(EXPONENT_BITS-1){1'b0}}, 1'b1, {MANTISSA_BITS{1'b0}}}
                : {sign_product, {EXPONENT_BITS{1'b0}}, sub_rounded[MANTISSA_BITS-1:0]};
        end else if (exp_adj >= ((1 << EXPONENT_BITS) - 1)) begin
            product_c = {sign_product, {EXPONENT_BITS{1'b1}}, {MANTISSA_BITS{1'b0}}};
        end else if (rounded_no_sign[FP_MSB] || (&rounded_no_sign[FP_MSB-1:MANTISSA_BITS])) begin
            product_c = {sign_product, {EXPONENT_BITS{1'b1}}, {MANTISSA_BITS{1'b0}}};
        end else begin
            product_c = {sign_product, rounded_no_sign[FP_MSB-1:0]};
        end
    end

    assign overflow_c = &product_c[FP_MSB-1:MANTISSA_BITS];
    assign underflow_c = ~|product_c[FP_MSB-1:MANTISSA_BITS];

    always_ff @(posedge i_clk) begin
        if (!i_rst_n) begin
            for (idx = 0; idx <= EXTRA_STAGES; idx = idx + 1) begin
                product_pipe[idx] <= '0;
                ovfl_pipe[idx] <= 1'b0;
                udfl_pipe[idx] <= 1'b0;
            end
        end else begin
            product_pipe[0] <= product_c;
            ovfl_pipe[0] <= overflow_c;
            udfl_pipe[0] <= underflow_c;
            for (idx = 1; idx <= EXTRA_STAGES; idx = idx + 1) begin
                product_pipe[idx] <= product_pipe[idx-1];
                ovfl_pipe[idx] <= ovfl_pipe[idx-1];
                udfl_pipe[idx] <= udfl_pipe[idx-1];
            end
        end
    end

    assign o_product = product_pipe[EXTRA_STAGES];
    assign o_ovfl = ovfl_pipe[EXTRA_STAGES];
    assign o_udfl = udfl_pipe[EXTRA_STAGES];

endmodule
