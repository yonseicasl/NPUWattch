{% import "_power_stim.sv.j2" as pwr %}
module fpmac_tb;
    localparam int EXPONENT_BITS = {{ exp_bits }};
    localparam int MANTISSA_BITS = {{ mantissa_bits }};
    localparam int PIPELINE_STAGES = {{ pipeline_stages }};
    localparam int FP_WIDTH = EXPONENT_BITS + MANTISSA_BITS + 1;
    localparam int NUM_CASES = {{ test_vectors|length }};

    logic [FP_WIDTH-1:0] i_a;
    logic [FP_WIDTH-1:0] i_b;
    logic [FP_WIDTH-1:0] i_c;
    logic i_clk;
    logic i_rst_n;
    logic [FP_WIDTH-1:0] o_result;
    logic o_ovfl;
    logic o_udfl;

    logic [FP_WIDTH-1:0] vec_a [0:NUM_CASES-1];
    logic [FP_WIDTH-1:0] vec_b [0:NUM_CASES-1];
    logic [FP_WIDTH-1:0] vec_c [0:NUM_CASES-1];
    logic [FP_WIDTH-1:0] vec_expected [0:NUM_CASES-1];
    string vec_desc [0:NUM_CASES-1];
    int errors;

    fpmac #(
        .EXPONENT_BITS(EXPONENT_BITS),
        .MANTISSA_BITS(MANTISSA_BITS),
        .PIPELINE_STAGES(PIPELINE_STAGES)
    ) dut (
        .i_a(i_a),
        .i_b(i_b),
        .i_c(i_c),
        .i_clk(i_clk),
        .i_rst_n(i_rst_n),
        .o_result(o_result),
        .o_ovfl(o_ovfl),
        .o_udfl(o_udfl)
    );

{{ pwr.decls("FP_WIDTH") }}
    task automatic nw_drive_random();
        i_a = FP_WIDTH'(nw_rand_bits(FP_WIDTH));
        i_b = FP_WIDTH'(nw_rand_bits(FP_WIDTH));
        i_c = FP_WIDTH'(nw_rand_bits(FP_WIDTH));
    endtask

{{ pwr.clock_gen("i_clk") }}
    initial begin
        i_rst_n = 1'b0;
        i_a = '0;
        i_b = '0;
        i_c = '0;
{% for vec in test_vectors %}
        vec_a[{{ vec.index }}] = {{ fp_width }}'h{{ vec.a_hex }};
        vec_b[{{ vec.index }}] = {{ fp_width }}'h{{ vec.b_hex }};
        vec_c[{{ vec.index }}] = {{ fp_width }}'h{{ vec.c_hex }};
        vec_expected[{{ vec.index }}] = {{ fp_width }}'h{{ vec.expected_hex }};
        vec_desc[{{ vec.index }}] = "{{ vec.desc }}";
{% endfor %}
        repeat (2) @(posedge i_clk);
        i_rst_n = 1'b1;

        for (int n = 0; n < NUM_CASES; n = n + 1) begin
            @(negedge i_clk);
            i_a = vec_a[n];
            i_b = vec_b[n];
            i_c = vec_c[n];
            repeat ({{ mac_latency }}) @(posedge i_clk);
            #1;
            $display("fpmac case=%0d desc=%s a=%h b=%h c=%h got=%h exp=%h ov=%0b ud=%0b",
                n, vec_desc[n], vec_a[n], vec_b[n], vec_c[n], o_result, vec_expected[n], o_ovfl, o_udfl);
            if (o_result !== vec_expected[n]) begin
                errors = errors + 1;
                $display("fpmac mismatch at case %0d", n);
            end
        end

        if (errors == 0) begin
            $display("fpmac_tb PASS");
        end else begin
            $display("fpmac_tb FAIL errors=%0d", errors);
            $fatal(1);
        end
{{ pwr.run_clocked("fpmac_tb", "i_clk", power_cycles) }}
        $finish;
    end

{{ pwr.saif_hook("fpmac_tb") }}
endmodule
