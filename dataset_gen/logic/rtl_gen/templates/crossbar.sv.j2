module {{ module_name }} #(
    parameter int DATA_WIDTH = {{ data_width }},
    parameter int NUM_INPUTS = {{ num_inputs }},
    parameter int NUM_OUTPUTS = {{ num_outputs }},
    parameter int DEST_WIDTH = (NUM_OUTPUTS <= 1) ? 1 : $clog2(NUM_OUTPUTS),
    parameter int IN_SEL_WIDTH = (NUM_INPUTS <= 1) ? 1 : $clog2(NUM_INPUTS)
) (
    input  logic [NUM_INPUTS*DATA_WIDTH-1:0]    i_data,
    input  logic [NUM_INPUTS-1:0]               i_valid,
    input  logic [NUM_INPUTS*DEST_WIDTH-1:0]    i_dest,
    output logic [NUM_OUTPUTS*DATA_WIDTH-1:0]   o_data,
    output logic [NUM_OUTPUTS-1:0]              o_valid,
    output logic [NUM_OUTPUTS*IN_SEL_WIDTH-1:0] o_sel,
    output logic [NUM_INPUTS-1:0]               o_grant
);

    always_comb begin
        o_data = '0;
        o_valid = '0;
        o_sel = '0;
        o_grant = '0;
        for (int dst = 0; dst < NUM_OUTPUTS; dst = dst + 1) begin
            for (int src = 0; src < NUM_INPUTS; src = src + 1) begin
                if (i_valid[src] &&
                    (i_dest[src*DEST_WIDTH +: DEST_WIDTH] == DEST_WIDTH'(dst)) &&
                    !o_valid[dst]) begin
                    o_data[dst*DATA_WIDTH +: DATA_WIDTH] = i_data[src*DATA_WIDTH +: DATA_WIDTH];
                    o_valid[dst] = 1'b1;
                    o_sel[dst*IN_SEL_WIDTH +: IN_SEL_WIDTH] = IN_SEL_WIDTH'(src);
                    o_grant[src] = 1'b1;
                end
            end
        end
    end

endmodule
