module {{ module_name }} #(
    parameter int DATA_WIDTH = {{ data_width }},
    parameter int NUM_INPUTS = {{ num_inputs }},
    parameter int SEL_WIDTH = (NUM_INPUTS <= 1) ? 1 : $clog2(NUM_INPUTS)
) (
    input  logic [NUM_INPUTS*DATA_WIDTH-1:0] i_data,
    input  logic [NUM_INPUTS-1:0]            i_valid,
    output logic [DATA_WIDTH-1:0]            o_data,
    output logic                             o_valid,
    output logic [SEL_WIDTH-1:0]             o_sel,
    output logic [NUM_INPUTS-1:0]            o_grant
);

    always_comb begin
        o_data = '0;
        o_valid = 1'b0;
        o_sel = '0;
        o_grant = '0;
        for (int src = 0; src < NUM_INPUTS; src = src + 1) begin
            if (i_valid[src] && !o_valid) begin
                o_data = i_data[src*DATA_WIDTH +: DATA_WIDTH];
                o_valid = 1'b1;
                o_sel = SEL_WIDTH'(src);
                o_grant[src] = 1'b1;
            end
        end
    end

endmodule
