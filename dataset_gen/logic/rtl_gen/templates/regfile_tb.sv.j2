{% import "_power_stim.sv.j2" as pwr %}
module {{ module_name }}_tb;
    localparam int DEPTH = {{ depth }};
    localparam int ADDR_WIDTH = {{ addr_width }};
    localparam int NUM_READ_PORTS = {{ num_read_ports }};
    localparam int W_PORT_WIDTH = {{ w_port_width }};
    localparam int W_ADDR_BITS = {{ w_addr_bits }};
    localparam int W_DATA_BITS = {{ w_data_bits }};
    localparam int R_ADDR_BITS = {{ r_addr_bits }};
    localparam int R_DATA_BITS = {{ r_data_bits }};
    localparam int NUM_CASES = {{ test_vectors|length }};

    logic i_clk;
    logic i_rst_n;
    logic [W_PORT_WIDTH-1:0] i_w_en;
    logic [W_ADDR_BITS-1:0] i_w_addr;
    logic [W_DATA_BITS-1:0] i_w_data;
    logic [R_ADDR_BITS-1:0] i_r_addr;
    logic [R_DATA_BITS-1:0] o_r_data;

    logic [W_PORT_WIDTH-1:0] vec_w_en [0:NUM_CASES-1];
    logic [W_ADDR_BITS-1:0] vec_w_addr [0:NUM_CASES-1];
    logic [W_DATA_BITS-1:0] vec_w_data [0:NUM_CASES-1];
    logic [R_ADDR_BITS-1:0] vec_r_addr [0:NUM_CASES-1];
    logic [R_DATA_BITS-1:0] vec_r_expected [0:NUM_CASES-1];
    int errors;

    regfile dut (
        .i_clk(i_clk),
        .i_rst_n(i_rst_n),
        .i_w_en(i_w_en),
        .i_w_addr(i_w_addr),
        .i_w_data(i_w_data),
        .i_r_addr(i_r_addr),
        .o_r_data(o_r_data)
    );

{{ pwr.decls("W_DATA_BITS") }}
    // Power-phase stimulus per +nw_power_mode (activity classes):
    //   random  both operations at random rates (legacy default)
    //   read    write ports quiet, read addresses random -> read-path power
    //   write   full-rate writes, read addresses held    -> write-path power
    //   idle    every input held, clock running          -> clock-tree power
    task automatic nw_drive_random();
        if (nw_power_mode == "random") begin
            i_w_en = W_PORT_WIDTH'(nw_rand_bits(W_PORT_WIDTH));
            i_w_data = W_DATA_BITS'(nw_rand_bits(W_DATA_BITS));
            for (int p = 0; p < W_PORT_WIDTH; p = p + 1) begin
                i_w_addr[p*ADDR_WIDTH +: ADDR_WIDTH] = ADDR_WIDTH'($urandom_range(0, DEPTH - 1));
            end
            for (int p = 0; p < NUM_READ_PORTS; p = p + 1) begin
                i_r_addr[p*ADDR_WIDTH +: ADDR_WIDTH] = ADDR_WIDTH'($urandom_range(0, DEPTH - 1));
            end
        end else if (nw_power_mode == "read") begin
            i_w_en = '0;
            i_w_data = '0;
            i_w_addr = '0;
            for (int p = 0; p < NUM_READ_PORTS; p = p + 1) begin
                i_r_addr[p*ADDR_WIDTH +: ADDR_WIDTH] = ADDR_WIDTH'($urandom_range(0, DEPTH - 1));
            end
        end else if (nw_power_mode == "write") begin
            i_w_en = '1;
            i_w_data = W_DATA_BITS'(nw_rand_bits(W_DATA_BITS));
            for (int p = 0; p < W_PORT_WIDTH; p = p + 1) begin
                i_w_addr[p*ADDR_WIDTH +: ADDR_WIDTH] = ADDR_WIDTH'($urandom_range(0, DEPTH - 1));
            end
            i_r_addr = '0;
        end else if (nw_power_mode == "idle") begin
            i_w_en = '0;
            i_w_data = '0;
            i_w_addr = '0;
            i_r_addr = '0;
        end else begin
            $fatal(1, "unsupported nw_power_mode for regfile: %s", nw_power_mode);
        end
    endtask

{{ pwr.clock_gen("i_clk") }}
    initial begin
        i_rst_n = 1'b0;
        i_w_en = '0;
        i_w_addr = '0;
        i_w_data = '0;
        i_r_addr = '0;
        errors = 0;
{% for vec in test_vectors %}
        vec_w_en[{{ vec.index }}] = {{ w_port_width }}'h{{ vec.w_en_hex }};
        vec_w_addr[{{ vec.index }}] = {{ w_addr_bits }}'h{{ vec.w_addr_hex }};
        vec_w_data[{{ vec.index }}] = {{ w_data_bits }}'h{{ vec.w_data_hex }};
        vec_r_addr[{{ vec.index }}] = {{ r_addr_bits }}'h{{ vec.r_addr_hex }};
        vec_r_expected[{{ vec.index }}] = {{ r_data_bits }}'h{{ vec.r_expected_hex }};
{% endfor %}
        repeat (2) @(posedge i_clk);
        i_rst_n = 1'b1;

        for (int n = 0; n < NUM_CASES; n = n + 1) begin
            @(negedge i_clk);
            i_w_en = vec_w_en[n];
            i_w_addr = vec_w_addr[n];
            i_w_data = vec_w_data[n];
            i_r_addr = vec_r_addr[n];
            @(posedge i_clk);
            #1;
            $display("regfile case=%0d r=%h exp=%h", n, o_r_data, vec_r_expected[n]);
            if (o_r_data !== vec_r_expected[n]) begin
                errors = errors + 1;
                $display("regfile mismatch at case %0d", n);
            end
        end

        if (errors == 0) begin
            $display("regfile_tb PASS");
        end else begin
            $display("regfile_tb FAIL errors=%0d", errors);
            $fatal(1);
        end
{{ pwr.run_clocked(module_name ~ "_tb", "i_clk", power_cycles) }}
        $finish;
    end

{{ pwr.saif_hook(module_name ~ "_tb") }}
endmodule
