#!/usr/bin/env bash
# Tutorial example 1 — Timeloop/Accelergy input.
#
# Feeds NPUWattch the Eyeriss-like architecture description and the eight
# per-layer stats files Timeloop produced for AlexNet, and writes an HTML
# report to out/.
#
# Usage: ./run [extra npuwattch flags...]

set -euo pipefail
cd "$(dirname "$0")"

if ! command -v npuwattch > /dev/null; then
    echo "npuwattch not found on PATH — install it first:" >&2
    echo "    cd ../.. && pip install -e ." >&2
    exit 1
fi

npuwattch --harness timeloop \
          --arch-yaml arch.yaml \
          --stats    stats/ \
          --node 7nm \
          --clock-mhz 1000 \
          --tree \
          --report out/ \
          "$@"

echo
echo "Open the report:  $(pwd)/out/report.html"
