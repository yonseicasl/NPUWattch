#!/usr/bin/env bash
# Tutorial example — PyTorchSim input, TPU-like bf16 datapath: one 1024³ matmul.
#
# The simulator data is the float32 run in ../../tpu_like_fp32/matmul_1024/.
# Only the hardware model differs: ../compound_components.yaml fixes the PE
# to a bf16 fpmac. The report goes to out/ in this folder.
#
# Usage: ./run [extra npuwattch flags...]

set -euo pipefail
cd "$(dirname "$0")"
DATA=../../tpu_like_fp32/matmul_1024

if ! command -v npuwattch > /dev/null; then
    echo "npuwattch not found on PATH — install it first:" >&2
    echo "    cd ../../../.. && pip install -e ." >&2
    exit 1
fi

npuwattch --harness pytorchsim \
          --togsim-dir  $DATA/togsim_results/ \
          --gem5-dir    $DATA/outputs/ \
          --config-yml  $DATA/config.yml \
          --booksim-dir $DATA/booksim2_config/ \
          --kernel-names        $DATA/kernels.yaml \
          --compound-components ../compound_components.yaml \
          --projection          ../projection.yaml \
          --user-components     ../user_components.yaml \
          --node 7nm \
          --tree \
          --report out/ \
          "$@"

echo
echo "Open the report:  $(pwd)/out/report.html"
